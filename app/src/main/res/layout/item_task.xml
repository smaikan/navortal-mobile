<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="36dp" android:gravity="center_vertical" android:orientation="horizontal">
    <View android:id="@+id/task_dot" android:layout_width="8dp" android:layout_height="8dp"
        android:background="@drawable/bg_task_dot" android:importantForAccessibility="no" />
    <TextView android:id="@+id/task_title" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginStart="12dp"
        android:textColor="@color/ink" android:textSize="15sp" />
    <TextView android:id="@+id/task_duration" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="12dp" android:fontFeatureSettings="tnum"
        android:textColor="@color/muted" android:textSize="13sp" />
</LinearLayout>
