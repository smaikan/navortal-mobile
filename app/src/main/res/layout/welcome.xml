<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" tools:ignore="Overdraw"
    android:id="@+id/welcome_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/welcome_bg" android:importantForAccessibility="no">

    <LinearLayout android:id="@+id/welcome_content" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical">

        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:clipToPadding="false" android:fillViewport="true" android:overScrollMode="ifContentScrolls" android:scrollbars="none">
            <LinearLayout android:id="@+id/welcome_hero" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp"
                android:paddingTop="8dp" android:paddingBottom="16dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="44dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_logo"
                        android:importantForAccessibility="no" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginStart="10dp" android:maxLines="1" android:ellipsize="end"
                        android:text="@string/brand_name" android:textColor="@color/ink" android:textSize="20sp"
                        android:textStyle="bold" android:letterSpacing="-0.015" />
                    <TextView android:id="@+id/welcome_date" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="8dp" android:gravity="end" android:maxLines="2"
                        android:fontFamily="sans-serif-medium" android:textColor="@color/muted" android:textSize="13sp" />
                </LinearLayout>

                <!-- Başlık üstte kalır; kalanı yer varsa dikeyde ortalanır, sığmazsa yukarıdan kaydırılır (fillViewport). -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
                    android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical">
                <FrameLayout android:layout_width="240dp" android:layout_height="240dp"
                    android:layout_gravity="center_horizontal" android:layout_marginTop="10dp">
                    <tr.com.navortal.DayRingView android:id="@+id/welcome_ring"
                        android:layout_width="match_parent" android:layout_height="match_parent" />
                    <LinearLayout android:layout_width="176dp" android:layout_height="176dp"
                        android:layout_gravity="center" android:gravity="center" android:orientation="vertical"
                        android:paddingStart="8dp" android:paddingEnd="8dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:gravity="center" android:maxLines="1" android:importantForAccessibility="no"
                            android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp"
                            android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp"
                            android:fontFamily="sans-serif-medium" android:text="@string/hero_label"
                            android:textColor="@color/muted" android:textSize="13sp" />
                        <TextView android:id="@+id/welcome_hero_value" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" android:layout_marginBottom="4dp"
                            android:gravity="center" android:maxLines="1" android:importantForAccessibility="no"
                                            android:fontFeatureSettings="tnum" android:includeFontPadding="false"
                            android:letterSpacing="-0.045" android:textStyle="bold"
                            android:textColor="@color/ink" android:textSize="44sp" />
                        <TextView android:id="@+id/welcome_hero_caption" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:gravity="center" android:maxLines="1" android:importantForAccessibility="no"
                            android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp"
                            android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp"
                            android:fontFeatureSettings="tnum" android:fontFamily="sans-serif-medium"
                            android:textColor="@color/muted" android:textSize="13sp" />
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:background="@drawable/bg_card"
                    android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:paddingTop="14dp" android:paddingBottom="14dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/plan_caption" android:textColor="@color/muted" android:textSize="13sp" />
                    <LinearLayout android:id="@+id/welcome_tasks" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" android:orientation="vertical" />
                    <tr.com.navortal.PlanBarView android:id="@+id/welcome_bar"
                        android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="8dp"
                        android:importantForAccessibility="no" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:orientation="horizontal">
                        <TextView android:id="@+id/welcome_sum_left" android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:fontFeatureSettings="tnum"
                            android:textColor="@color/ink" android:textSize="14sp" />
                        <TextView android:id="@+id/welcome_sum_right" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginStart="12dp" android:gravity="end" android:fontFeatureSettings="tnum"
                            android:textColor="@color/free_green" android:textSize="14sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:text="@string/brand_line"
                    android:fontFamily="sans-serif-medium" android:letterSpacing="-0.013"
                    android:textColor="@color/ink" android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <LinearLayout android:id="@+id/welcome_panel" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_panel_bottom" android:orientation="vertical"
            android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="22dp" android:paddingBottom="12dp">

            <Button android:id="@+id/welcome_register" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="56dp" android:background="@drawable/bg_button_primary" android:stateListAnimator="@null"
                android:text="@string/cta_primary" android:textAllCaps="false" android:textColor="@color/white"
                android:textSize="17sp" android:fontFamily="sans-serif-medium" />

            <Button android:id="@+id/welcome_google" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:minHeight="52dp"
                android:background="@drawable/bg_button_google" android:stateListAnimator="@null"
                android:text="@string/cta_google" android:textAllCaps="false" android:textColor="@color/ink"
                android:textSize="16sp" android:fontFamily="sans-serif-medium" />

            <tr.com.navortal.InlineRow android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:gravity="center_horizontal" android:orientation="horizontal">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:minHeight="48dp" android:gravity="center_vertical" android:text="@string/login_prompt"
                    android:textColor="@color/muted_panel" android:textSize="15sp" />
                <Button android:id="@+id/welcome_login" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:minWidth="48dp" android:minHeight="48dp" android:paddingStart="6dp" android:paddingEnd="2dp"
                    android:background="@drawable/bg_button_text" android:stateListAnimator="@null"
                    android:text="@string/login_action" android:textAllCaps="false" android:textColor="@color/link"
                    android:textSize="15sp" android:fontFamily="sans-serif-medium" />
            </tr.com.navortal.InlineRow>

            <tr.com.navortal.InlineRow android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_horizontal" android:orientation="horizontal">
                <Button android:id="@+id/welcome_terms" style="@style/LegalLink" android:text="@string/legal_terms" />
                <TextView android:tag="sep" style="@style/LegalSeparator" android:text="@string/legal_separator" />
                <Button android:id="@+id/welcome_privacy" style="@style/LegalLink" android:text="@string/legal_privacy" />
                <TextView android:tag="sep" style="@style/LegalSeparator" android:text="@string/legal_separator" />
                <Button android:id="@+id/welcome_kvkk" style="@style/LegalLink" android:text="@string/legal_kvkk" />
            </tr.com.navortal.InlineRow>
        </LinearLayout>
    </LinearLayout>

    <ScrollView android:id="@+id/welcome_sheet_layer" android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@color/scrim" android:fillViewport="true" android:visibility="gone"
        android:importantForAccessibility="no" android:overScrollMode="ifContentScrolls" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:importantForAccessibility="no" />
            <LinearLayout android:id="@+id/welcome_sheet" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/bg_sheet" android:orientation="vertical"
                android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="12dp" android:paddingBottom="28dp">
                <View android:layout_width="36dp" android:layout_height="4dp" android:layout_gravity="center_horizontal"
                    android:background="@drawable/bg_grabber" android:importantForAccessibility="no" />
                <FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:layout_marginTop="20dp"
                    android:background="@drawable/bg_icon_box" android:importantForAccessibility="no">
                    <ImageView android:id="@+id/welcome_sheet_icon" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center"
                        android:src="@drawable/ic_wifi_off" android:importantForAccessibility="no" />
                </FrameLayout>
                <TextView android:id="@+id/welcome_sheet_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="@string/offline_title"
                    android:textColor="@color/ink" android:textSize="20sp" android:textStyle="bold" />
                <TextView android:id="@+id/welcome_sheet_body" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:lineSpacingMultiplier="1.2" android:text="@string/offline_body"
                    android:textColor="@color/muted_panel" android:textSize="15sp" />
                <Button android:id="@+id/welcome_sheet_retry" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="20dp" android:minHeight="52dp" android:background="@drawable/bg_button_primary"
                    android:stateListAnimator="@null" android:text="@string/offline_retry" android:textAllCaps="false"
                    android:textColor="@color/white" android:textSize="16sp" android:fontFamily="sans-serif-medium" />
                <Button android:id="@+id/welcome_sheet_close" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:minHeight="48dp" android:background="@drawable/bg_button_text"
                    android:stateListAnimator="@null" android:text="@string/offline_close" android:textAllCaps="false"
                    android:textColor="@color/ink" android:textSize="15sp" android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
