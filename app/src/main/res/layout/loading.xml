<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" tools:ignore="Overdraw"
    android:id="@+id/loading_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/panel" android:orientation="vertical" android:importantForAccessibility="no">
    <ProgressBar android:id="@+id/loading_bar" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="3dp"
        android:indeterminate="false" android:max="100" android:progress="0"
        android:progressDrawable="@drawable/progress_loading"
        android:contentDescription="@string/loading_progress" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:gravity="center" android:orientation="vertical" android:paddingStart="32dp" android:paddingEnd="32dp">
        <ImageView android:layout_width="64dp" android:layout_height="64dp" android:src="@drawable/ic_logo"
            android:importantForAccessibility="no" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:text="@string/brand_name"
            android:textColor="@color/ink" android:textSize="20sp" android:textStyle="bold" android:letterSpacing="-0.015" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:gravity="center" android:text="@string/loading_status"
            android:accessibilityLiveRegion="polite" android:textColor="@color/muted_panel" android:textSize="15sp" />
    </LinearLayout>
    <Button android:id="@+id/loading_cancel" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:layout_marginBottom="28dp"
        android:minHeight="48dp" android:background="@drawable/bg_button_text" android:stateListAnimator="@null"
        android:text="@string/loading_cancel" android:textAllCaps="false" android:textColor="@color/ink"
        android:textSize="15sp" android:fontFamily="sans-serif-medium" />
</LinearLayout>
